[configuration]
entry_symbol = "loxfx_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://experiments/loxfx/bin/libloxfx_godot.so"
linux.release.x86_64 = "res://experiments/loxfx/bin/libloxfx_godot.so"
windows.debug.x86_64 = "res://experiments/loxfx/bin/loxfx_godot.dll"
windows.release.x86_64 = "res://experiments/loxfx/bin/loxfx_godot.dll"
